<Page
    x:Class="V0XMediaEncode.App.Views.WatchFoldersPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:V0XMediaEncode.App.ViewModels"
    Background="{StaticResource V0XBackgroundBrush}">

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Dossiers surveillés" FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource V0XTextPrimaryBrush}" />
            <TextBlock Text="Un fichier ajouté à un dossier ci-dessous est automatiquement mis en file avec son preset par défaut."
                       Foreground="{StaticResource V0XTextSecondaryBrush}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,16,0,16">
            <Button Content="Ajouter un dossier..." Click="AddFolderButton_Click" Background="{StaticResource V0XAccentBrush}" />
        </StackPanel>

        <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:WatchedFolderRow">
                    <Grid Padding="10" ColumnSpacing="12" Background="{StaticResource V0XPanelBackgroundBrush}" Margin="0,0,0,4" CornerRadius="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0"
                                  IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                  Command="{Binding ElementName=RootPage, Path=ViewModel.ToggleEnabledCommand}"
                                  CommandParameter="{Binding Folder}"
                                  VerticalAlignment="Center" />

                        <TextBlock Grid.Column="1" Text="{Binding Path}"
                                   Foreground="{StaticResource V0XTextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />

                        <TextBlock Grid.Column="2" Text="{Binding PresetName}"
                                   Foreground="{StaticResource V0XTextSecondaryBrush}"
                                   VerticalAlignment="Center" />

                        <Button Grid.Column="3" Content="Retirer"
                                Command="{Binding ElementName=RootPage, Path=ViewModel.RemoveFolderCommand}"
                                CommandParameter="{Binding Folder}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
