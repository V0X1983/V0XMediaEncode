<Page
    x:Class="V0XMediaEncode.App.Views.HistoryPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:V0XMediaEncode.Core.Models"
    Background="{StaticResource V0XBackgroundBrush}">

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Historique" FontSize="20" FontWeight="SemiBold"
                   Foreground="{StaticResource V0XTextPrimaryBrush}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,16,0,16">
            <Button Content="Actualiser" Command="{x:Bind ViewModel.RefreshCommand}" />
            <Button Content="Exporter tout l'historique..." Click="ExportAllButton_Click" Background="{StaticResource V0XAccentBrush}" />
        </StackPanel>

        <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:HistoryEntry">
                    <Grid Padding="10" ColumnSpacing="12" Background="{StaticResource V0XPanelBackgroundBrush}" Margin="0,0,0,4" CornerRadius="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding FileName}"
                                   Foreground="{StaticResource V0XTextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                        <TextBlock Grid.Column="1" Text="{Binding PresetName}"
                                   Foreground="{StaticResource V0XTextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                        <TextBlock Grid.Column="2" Text="{Binding Status}"
                                   Foreground="{StaticResource V0XTextSecondaryBrush}" VerticalAlignment="Center" />

                        <TextBlock Grid.Column="3" Text="{Binding Duration}"
                                   Foreground="{StaticResource V0XTextSecondaryBrush}" VerticalAlignment="Center" />

                        <TextBlock Grid.Column="4" Text="{Binding CompletedAt}"
                                   Foreground="{StaticResource V0XTextSecondaryBrush}" VerticalAlignment="Center" />

                        <Button Grid.Column="5" Content="Exporter le journal"
                                Tag="{Binding}"
                                Click="ExportEntryButton_Click" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
