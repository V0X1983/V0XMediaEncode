<Page
    x:Class="V0XMediaEncode.App.Views.QueuePage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:V0XMediaEncode.Core.Models"
    xmlns:converters="using:V0XMediaEncode.App.Converters"
    Background="{StaticResource V0XBackgroundBrush}">

    <Page.Resources>
        <converters:NullToVisibleConverter x:Key="NullToVisibleConverter" />
        <converters:PercentToTextConverter x:Key="PercentToTextConverter" />
        <converters:SpeedFactorToTextConverter x:Key="SpeedFactorToTextConverter" />
        <converters:EtaToTextConverter x:Key="EtaToTextConverter" />
        <converters:NotNullOrEmptyToVisibleConverter x:Key="NotNullOrEmptyToVisibleConverter" />
    </Page.Resources>

    <Grid Padding="20" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" AllowDrop="True" DragOver="RootGrid_DragOver" Drop="RootGrid_Drop">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
                <Button Content="Ajouter des fichiers..." Click="AddFilesButton_Click" />
                <ComboBox Width="260"
                          ItemsSource="{x:Bind ViewModel.AvailablePresets, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedPreset, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          PlaceholderText="Preset par défaut" />
                <Button Content="Démarrer la file" Command="{x:Bind ViewModel.StartQueueCommand}" Background="{StaticResource V0XAccentBrush}" />
                <Button Content="Annuler" Command="{x:Bind ViewModel.CancelQueueCommand}" />
            </StackPanel>

            <Grid Grid.Row="1">
                <ListView ItemsSource="{x:Bind ViewModel.Jobs, Mode=OneWay}"
                          SelectionMode="Single"
                          SelectionChanged="JobsListView_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:EncodeJob">
                            <Grid Padding="10" RowSpacing="4" Background="{StaticResource V0XPanelBackgroundBrush}" Margin="0,0,0,4" CornerRadius="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="280" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}"
                                                   Foreground="{StaticResource V0XTextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding OutputFileName}"
                                                   Foreground="{StaticResource V0XTextSecondaryBrush}"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Preset.Name}"
                                               Foreground="{StaticResource V0XTextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />

                                    <ProgressBar Grid.Column="2"
                                                 Minimum="0" Maximum="100"
                                                 Value="{Binding ProgressPercent}"
                                                 VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="3"
                                               Foreground="{StaticResource V0XTextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center">
                                        <Run Text="{Binding ProgressPercent, Converter={StaticResource PercentToTextConverter}}" />
                                        <Run Text="{Binding SpeedFactor, Converter={StaticResource SpeedFactorToTextConverter}}" />
                                        <Run Text="{Binding Eta, Converter={StaticResource EtaToTextConverter}}" />
                                    </TextBlock>

                                    <TextBlock Grid.Column="4"
                                               Text="{Binding Status}"
                                               Foreground="{StaticResource V0XTextSecondaryBrush}"
                                               VerticalAlignment="Center" />

                                    <Button Grid.Column="5"
                                            Content="Retirer"
                                            Command="{Binding ElementName=RootPage, Path=ViewModel.RemoveJobCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>

                                <TextBlock Grid.Row="1"
                                           Text="{Binding ErrorMessage}"
                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding ErrorMessage, Converter={StaticResource NotNullOrEmptyToVisibleConverter}}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!-- Aperçu (Phase 7) : miniature en poster, lecture native via MediaPlayerElement -->
        <Grid Grid.Column="1" Background="{StaticResource V0XPanelBackgroundBrush}" CornerRadius="4" Padding="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Aperçu" FontWeight="SemiBold"
                       Foreground="{StaticResource V0XTextPrimaryBrush}" Margin="0,0,0,8" />

            <Grid Grid.Row="1">
                <TextBlock Text="Sélectionnez un fichier dans la file pour l'aperçu"
                           Foreground="{StaticResource V0XTextSecondaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Visibility="{x:Bind ViewModel.SelectedJob, Mode=OneWay, Converter={StaticResource NullToVisibleConverter}}" />

                <MediaPlayerElement x:Name="PreviewPlayer"
                                    AutoPlay="False"
                                    AreTransportControlsEnabled="True"
                                    Stretch="Uniform"
                                    PosterSource="{x:Bind ViewModel.PreviewThumbnail, Mode=OneWay}" />
            </Grid>
        </Grid>
    </Grid>
</Page>
