<Page
    x:Class="V0XMediaEncode.App.Views.SettingsPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource V0XBackgroundBrush}">

    <StackPanel Padding="20" Spacing="16" MaxWidth="480" HorizontalAlignment="Left">
        <TextBlock Text="Paramètres" FontSize="20" FontWeight="SemiBold"
                   Foreground="{StaticResource V0XTextPrimaryBrush}" />

        <StackPanel Spacing="4">
            <TextBlock Text="Version" FontWeight="SemiBold"
                       Foreground="{StaticResource V0XTextPrimaryBrush}" />
            <TextBlock Text="{x:Bind ViewModel.AppVersion}"
                       Foreground="{StaticResource V0XTextSecondaryBrush}" />
        </StackPanel>

        <StackPanel Spacing="8">
            <TextBlock Text="Mises à jour" FontWeight="SemiBold"
                       Foreground="{StaticResource V0XTextPrimaryBrush}" />
            <TextBlock Text="{x:Bind ViewModel.UpdateStatusText, Mode=OneWay}"
                       Foreground="{StaticResource V0XTextSecondaryBrush}"
                       TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Rechercher les mises à jour"
                        Command="{x:Bind ViewModel.CheckForUpdatesCommand}"
                        IsEnabled="{x:Bind ViewModel.CanCheckForUpdates, Mode=OneWay}" />
                <Button Content="Installer et redémarrer"
                        Command="{x:Bind ViewModel.DownloadAndApplyUpdateCommand}"
                        Visibility="{x:Bind ViewModel.CanApplyUpdate, Mode=OneWay}"
                        Background="{StaticResource V0XAccentBrush}" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</Page>
